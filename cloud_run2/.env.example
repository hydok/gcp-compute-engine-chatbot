# API 키 없음 - ADC(Application Default Credentials)로 인증한다.
# 로컬 실행 전 아래 1회 필요: gcloud auth application-default login

# 선택: 자동 감지 실패 시에만 명시 (보통 비워둬도 됨)
# PROJECT_ID=your-gcp-project-id

# 선택: Vertex AI 리전
# LOCATION=us-central1

# 선택: 드롭다운에 노출할 모델 ID (쉼표 구분, 첫 번째가 기본값)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# 선택: 포트
# PORT=8080
